**/dist/
**/build/
**/out/
**/tmp/
**/bazel-out/
**/.angular/cache/
**/.cache/
**/.parcel-cache/
**/.next/
**/.nuxt/
**/.serverless/
**/.vercel/
**/.svelte-kit/

# ===============================
#  Тесты и покрытие
# ===============================
**/coverage/
**/.nyc_output/
**/__screenshots__/
**/testem.log
**/junit.xml

# ===============================
#  Файлы окружения и секреты
# ===============================
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.crt

# ===============================
#  Системные файлы ОС
# ===============================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ===============================
#  Редакторы кода и IDE
# ===============================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Eclipse / Spring Tool Suite
.project
.classpath
.settings/
*.launch

# C9 / Cloud9
.c9/

# ===============================
#  Логи и временные файлы
# ===============================
*.log
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

# ===============================
#  Специфичное для Angular
# ===============================
**/.angular/cache/
**/.ngcc_cache/

# ===============================
#  Специфичное для React / Create React App
# ===============================
**/node_modules/.cache/

# ===============================
#  Специфичное для Vite
# ===============================
**/vite.config.js.timestamp-*
**/vite.config.ts.timestamp-*

# ===============================
#  Другое
# ===============================
# Папки с документацией (если генерируются)
**/docs/_build/
**/site/

# Рабочие файлы TypeScript (если не используете incremental)
**/*.tsbuildinfo

# Файлы, создаваемые некоторыми инструментами
**/.eslintcache
**/.stylelintcache
**/.prettiercache